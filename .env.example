# API keys — copy to .env and fill in.
# HF token (read scope) — required for the gated dataset download.
HF_TOKEN=

# Anthropic (primary + reflection LM).
ANTHROPIC_API_KEY=

# Optional: heterogeneous panel via OpenRouter (one key, many models).
# Without it, the panel collapses to the primary Claude model.
OPENROUTER_API_KEY=

# Optional model overrides (defaults in config.py).
# PRIMARY_LM=anthropic/claude-sonnet-4-5-20250929
# SUB_LM=anthropic/claude-haiku-4-5-20251001
# REFLECTION_LM=anthropic/claude-sonnet-4-5-20250929

# Optional: relocate the DSPy disk cache (default ~/.dspy_cache, 30 GB cap).
# The cache stores LM responses verbatim — including variant data sent to
# providers — so `./run.sh purge-cache` must clear it at the deletion mark.
# DSPY_CACHEDIR=~/.dspy_cache
